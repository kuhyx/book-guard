[Unit]
Description=Re-check the reading pace when the day turns

[Timer]
# One number a day (RESPLIT_DATE): the verdict only changes when a day ends
# with its number missed, or when today's number is read (the lock window
# lets go by itself). So the gate is armed at login (book-guard.service) and
# the moment the day turns -- no daytime hours.
OnCalendar=*-*-* 00:00:30
# The morning-session carrot (wake-alarm) holds the gate until 11:00 for a
# morning completed in time; this slot re-decides the moment it expires,
# like screen-locker's early-bird check.
OnCalendar=*-*-* 11:00:30
Unit=book-guard.service
# Persistent: a slot missed while the PC was off fires at next boot rather
# than being dropped for the day.
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
